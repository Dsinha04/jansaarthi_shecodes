
# Backend (port 8000)
AI_CORE_URL=http://127.0.0.1:8001
AI_CORE_KEY=
DB_PATH=./data/jansaarthi.db
SESSION_HOURS=1
CORS_ORIGINS=http://localhost:5173
# Hardware: mock | real   (mock = works on a laptop with no devices)
HARDWARE_MODE=mock
STT_MODE=auto            # auto | whisper | mock
OCR_MODE=auto            # auto | tesseract | api | mock   (api = online OCR, see below)
TRANSLATE_MODE=auto      # auto | api | passthrough
TRANSLATE_API_URL=       # POST {text, source, target} -> {text}
PRINTER_NAME=            # CUPS printer; empty = save receipt to ./data/receipts only
ADMIN_KEY=               # required for /api/admin/* ; empty disables them

         # full path to tesseract.exe if it is not on PATH, e.g. C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# --- Online OCR (optional). Use this if Tesseract will not install or reads Hindi badly.
# Set OCR_MODE=api above. Your document photo is sent to this service, so it is never used automatically.
# OCR_API_KEY=             # defaults to LLM_API_KEY
# OCR_MODEL=               # a model that accepts images (defaults to LLM_MODEL)
# OCR_API_URL=             # OpenAI-compatible chat completions URL (defaults to LLM_API_URL, then OpenAI)
# OCR_TOKEN_PARAM=         # max_completion_tokens for newer OpenAI models (defaults to LLM_TOKEN_PARAM)
